# Environment variables / secrets
.env
.env.*
!.env.example
*.env
# Deploy build context needs these env files present (values are non-secret
# templates/config; real secrets are injected via the platform's managed secrets):
!backend/.env
!frontend/.env

# Credentials / certificates
credentials.json
.credentials
*.pem
*.key

# Dependencies
node_modules/
.venv/
**/.venv/

# Python cache
__pycache__/
**/__pycache__/
*.pyc

# Build artifacts
dist/
frontend/dist/
